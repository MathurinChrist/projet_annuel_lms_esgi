# EduPulse production env (VPS) — copy to .env on the server (never commit)

DB_USER=lmsuser
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=lmsdb

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

APP_URL=https://edupulselms.eu
APP_PORT=3000
NODE_ENV=production
PORT=3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://edupulselms.eu/api/auth/google/callback

# SMTP — Mailpit (catcher UI on :8025 / mail.edupulselms.eu)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EduPulse <noreply@edupulselms.eu>

# LiveKit Cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HOST=https://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud

# OpenAI (optional — AI quizzes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (recommended in production): YouTube blocks caption fetch from VPS IPs.
# With GEMINI_API_KEY, the app asks Gemini to read the YouTube video directly.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
