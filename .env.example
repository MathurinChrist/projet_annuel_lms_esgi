# variable for database
DATABASE_URL="postgresql://lmsuser:lmspassword@localhost:5432/lmsdb?schema=public"

# Docker Postgres Service variables
DB_USER=lmsuser
DB_PASSWORD=lmspassword
DB_NAME=lmsdb

# configuration de l'authentification
JWT_SECRET="generate-a-long-random-string-here"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# configiration de l'application
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# configuration smtp
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="lms@gmail.com"
SMTP_PASS="lms_password"
EMAIL_FROM="EduPulse <noreply@lms.com>"

# configuration docker
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_HOST=http://livekit:7880

# Agent IA (formateur)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
