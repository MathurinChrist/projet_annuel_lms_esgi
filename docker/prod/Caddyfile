# EduPulse — reverse proxy HTTPS
# Requires DNS A record: edupulselms.eu → VPS IP
# Ports 80 + 443 must be free for Let's Encrypt.

edupulselms.eu, www.edupulselms.eu {
	encode gzip
	reverse_proxy app:3000
}

# Optional: DNS A mail → same VPS IP to open Mailpit UI over HTTPS
mail.edupulselms.eu {
	encode gzip
	reverse_proxy mailpit:8025
}
