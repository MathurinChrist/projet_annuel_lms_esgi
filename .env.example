# variable for database
DATABASE_URL="postgresql://lmsuser:lmspassword@localhost:5432/lmsdb?schema=public"

# Docker Postgres Service variables
DB_USER=lmsuser
DB_PASSWORD=lmspassword
DB_NAME=lmsdb

# configuration de l'authentification
JWT_SECRET="generate-a-long-random-string-here"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# configiration de l'application
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# SMTP — Mailpit (dev catcher, no real delivery)
SMTP_HOST="mailpit"
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EduPulse <noreply@edupulselms.eu>"

# configuration docker
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_HOST=https://your-project.livekit.cloud

# Agent IA (formateur)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional prod fallback when YouTube blocks VPS caption fetch
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
