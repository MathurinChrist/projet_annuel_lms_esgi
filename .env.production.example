# EduPulse production env (VPS) — copy to .env on the server (never commit)

DB_USER=lmsuser
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=lmsdb

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

APP_URL=http://54.37.159.216
APP_PORT=3000
NODE_ENV=production
PORT=3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://54.37.159.216/api/auth/google/callback

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EduPulse <noreply@edupulse.local>

# LiveKit (optional)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_HOST=http://127.0.0.1:7880
LIVEKIT_URL=ws://54.37.159.216:7880

# OpenAI (optional — AI quizzes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (recommended in production): YouTube blocks caption fetch from VPS IPs.
# With GEMINI_API_KEY, the app asks Gemini to read the YouTube video directly.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
